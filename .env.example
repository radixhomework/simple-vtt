# Simple VTT — Docker configuration
# Copy this file to .env and adjust for your deployment:
#   cp .env.example .env
# docker compose reads .env automatically; missing values fall back to
# the defaults built into docker-compose.yml.

# Port exposed on the host (container always listens on 8080)
HTTP_PORT=8080

# Secret used to sign JWTs — change this in production
JWT_SECRET=change-me-in-production

# Initial admin account created at startup
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
