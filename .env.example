# Simple VTT — Docker configuration
# Copy this file to .env and adjust for your deployment:
#   cp .env.example .env
# docker compose reads .env automatically; missing values fall back to
# the defaults built into docker-compose.yml.

# Port exposed on the host (container always listens on 8080)
HTTP_PORT=8080

# Secret used to sign JWTs — change this in production
JWT_SECRET=change-me-in-production

# Initial admin account created at startup
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# Blob storage (default: local filesystem under the data volume).
# Switch to STORAGE_DRIVER=s3 to store maps/tiles/masks/assets in an
# S3-compatible bucket (MinIO, AWS, B2...). Then run once:
#   docker compose exec app node dist/migrate-to-s3.js
# Then, once the app serves from the bucket, reclaim the local copies:
#   docker compose exec app node dist/prune-local-uploads.js [--delete]
#STORAGE_DRIVER=s3
#S3_ENDPOINT=http://minio.home:9000
#S3_BUCKET=simple-vtt
#S3_REGION=us-east-1
#S3_ACCESS_KEY=changeme
#S3_SECRET_KEY=changeme
